# Copy this file to server/.env and fill in the values.
# server/.env is ignored by git and must never be committed (SRS SEC-12).

# Port the API listens on
PORT=5000

# MongoDB connection string.
# Local install:  mongodb://localhost:27017/pfem
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>/pfem?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/pfem

# Origin allowed to call the API. The Vite dev server uses port 5173.
CLIENT_ORIGIN=http://localhost:5173

# Development shortcut only: lets scripts say which user they are with an
# X-User-Id header instead of a real sign-in. OFF by default. The server refuses
# to start in production if it is on (US-28, SEC-4/SEC-12).
DEV_AUTH_HEADER=false

# Signs the session token (US-04). At least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate: 32+ random characters>

# Hashes the six-digit email verification code (US-03). At least 32 characters.
EMAIL_VERIFICATION_SECRET=<generate: 32+ random characters>

# SMTP, used to send the verification code. Leave blank for local development
# and set DEV_EMAIL_CONSOLE=true below instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# TEMPORARY, local only: with no SMTP server, print the verification code to the
# API console instead of emailing it. Never set this in production.
DEV_EMAIL_CONSOLE=true

# Receipt attachments (US-23). Files are stored here, outside anything the web
# server serves. Default: server/uploads (already in .gitignore).
UPLOAD_DIR=

# Signs the short-lived attachment URLs (REQ-81). At least 32 characters.
# Falls back to JWT_SECRET when left blank.
ATTACHMENT_URL_SECRET=

# App lock (US-05). Keys the HMAC that is applied to a PIN before it is hashed,
# so a copy of the database cannot be searched offline for four-digit PINs.
# At least 32 characters. Falls back to JWT_SECRET when left blank. Changing it
# invalidates every stored PIN (users then use "Forgot PIN?").
APP_LOCK_SECRET=

# Device biometric unlock (US-05, WebAuthn). The browser checks these against
# the address bar, so they must match how users reach the CLIENT, not the API.
# Both default to CLIENT_ORIGIN (and its host name). Production needs https.
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_ID=

# Recurring transactions and bill reminders (US-16, US-17).
# The scheduler runs inside the API process: once at start-up (catching up on
# anything missed while it was down) and then every minute. Every pass is made
# safe to repeat by unique indexes in the database, so running several API
# instances, or restarting, never creates a duplicate.
# Set to false to turn the scheduler off in this process.
SCHEDULER_ENABLED=true
# How often it runs, in milliseconds (default 60000).
SCHEDULER_TICK_MS=
# The time zone that decides what "today" and "00:05" mean. Default Asia/Kolkata.
APP_TIMEZONE=

# Bill reminder delivery. In-app notices always work. Email uses the SMTP_*
# settings above and EMAIL_FROM: with them set, reminders are really emailed;
# without them an email is recorded as "skipped_not_configured" (or, with
# DEV_EMAIL_CONSOLE=true outside production, printed and recorded as
# "logged_dev"). It is never recorded as sent when it was not.
# Push needs a provider: see README, "Recurring transactions and bill reminders".

# ===========================================================================
# US-28 (#67) security hardening and US-26 (#62) administration
# Every value below is a secret or a deployment setting. Never commit real ones.
# Generate 32 random bytes with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ===========================================================================

# --- Encryption at rest (SEC-3) --------------------------------------------
# AES-256-GCM key for names, emails, mobile numbers, notes and receipt files.
# REQUIRED. Losing it makes that data unreadable; keep a copy in a secret manager.
ENCRYPTION_KEY=
# Label stored with each encrypted value. Change it when you rotate the key.
ENCRYPTION_KEY_ID=1
# After a rotation, list the old keys here so existing data stays readable:
#   ENCRYPTION_KEYS_PREVIOUS=1:<old key>,0:<older key>
ENCRYPTION_KEYS_PREVIOUS=
# Keys the lookup hash for encrypted emails. REQUIRED in production and must
# NEVER change (changing it breaks sign-in lookups). In development it is
# derived from ENCRYPTION_KEY when left blank.
BLIND_INDEX_KEY=

# --- Transport and browser security (SEC-1, SEC-6) --------------------------
# Production: exact https origin(s) of the web client, comma-separated. No "*".
# CLIENT_ORIGIN (above) is used for CORS and the CSRF origin check.
# Redirect/refuse plain HTTP. Defaults to true in production, false otherwise.
FORCE_HTTPS=
# Number of reverse proxies in front of the API (1 for one nginx/load balancer).
# REQUIRED in production. Leave blank locally. Never use "true": X-Forwarded-For
# is believed only for this many hops, so clients cannot forge their IP (SEC-7).
TRUST_PROXY=

# --- Passwords, sessions, rate limits (SEC-2, SEC-7, SEC-8) -----------------
# bcrypt cost. 12 is the minimum and the default; higher is slower and safer.
BCRYPT_ROUNDS=12
# Server-enforced inactivity timeout. 30 is the maximum; lower values allowed.
SESSION_IDLE_TIMEOUT_MINUTES=30
# Requests per minute: per IP overall, and per account on sign-in/registration/
# verification/password reset.
RATE_LIMIT_GLOBAL_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=10
# Set to false only for load tests. Counters are per API process (see docs/SECURITY.md).
RATE_LIMIT_ENABLED=true

# --- Audit trail (REQ-96) ---------------------------------------------------
# Days to keep audit records. 365 (12 months) is the minimum and the default.
AUDIT_RETENTION_DAYS=365

# --- Privacy (SEC-13) -------------------------------------------------------
# Version of the privacy notice users consent to. Change it when the notice does.
PRIVACY_POLICY_VERSION=2026-11

# --- Encrypted backups (REQ-97) ---------------------------------------------
# Key for backup files. REQUIRED while backups are on. Must differ from
# ENCRYPTION_KEY, and must be stored OUTSIDE the server that holds the backups.
BACKUP_ENCRYPTION_KEY=
# Where backup files are written. Must not be inside UPLOAD_DIR or any directory
# a web server serves. Default: server/backups (ignored by Git).
BACKUP_DIR=
# Days to keep backups. 7 is the default (REQ-97).
BACKUP_RETENTION_DAYS=7
# Set to false on API instances that should not run the daily backup job.
BACKUP_ENABLED=true
