# Copy this file to server/.env and fill in the values.
# server/.env is ignored by git and must never be committed (SRS SEC-12).

# Port the API listens on
PORT=5000

# MongoDB connection string.
# Local install:  mongodb://localhost:27017/pfem
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>/pfem?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/pfem

# Origin allowed to call the API. The Vite dev server uses port 5173.
CLIENT_ORIGIN=http://localhost:5173

# TEMPORARY until sign-in (US-04) is merged. Lets the local client say which
# user it is with an X-User-Id header. Never set this in production.
DEV_AUTH_HEADER=true

# Signs the session token (US-04). At least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Hashes the six-digit email verification code (US-03). At least 32 characters.
EMAIL_VERIFICATION_SECRET=

# SMTP, used to send the verification code. Leave blank for local development
# and set DEV_EMAIL_CONSOLE=true below instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# TEMPORARY, local only: with no SMTP server, print the verification code to the
# API console instead of emailing it. Never set this in production.
DEV_EMAIL_CONSOLE=true

# Receipt attachments (US-23). Files are stored here, outside anything the web
# server serves. Default: server/uploads (already in .gitignore).
UPLOAD_DIR=

# Signs the short-lived attachment URLs (REQ-81). At least 32 characters.
# Falls back to JWT_SECRET when left blank.
ATTACHMENT_URL_SECRET=

# App lock (US-05). Keys the HMAC that is applied to a PIN before it is hashed,
# so a copy of the database cannot be searched offline for four-digit PINs.
# At least 32 characters. Falls back to JWT_SECRET when left blank. Changing it
# invalidates every stored PIN (users then use "Forgot PIN?").
APP_LOCK_SECRET=

# Device biometric unlock (US-05, WebAuthn). The browser checks these against
# the address bar, so they must match how users reach the CLIENT, not the API.
# Both default to CLIENT_ORIGIN (and its host name). Production needs https.
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_ID=

# Recurring transactions and bill reminders (US-16, US-17).
# The scheduler runs inside the API process: once at start-up (catching up on
# anything missed while it was down) and then every minute. Every pass is made
# safe to repeat by unique indexes in the database, so running several API
# instances, or restarting, never creates a duplicate.
# Set to false to turn the scheduler off in this process.
SCHEDULER_ENABLED=true
# How often it runs, in milliseconds (default 60000).
SCHEDULER_TICK_MS=
# The time zone that decides what "today" and "00:05" mean. Default Asia/Kolkata.
APP_TIMEZONE=

# Bill reminder delivery. In-app notices always work. Email uses the SMTP_*
# settings above and EMAIL_FROM: with them set, reminders are really emailed;
# without them an email is recorded as "skipped_not_configured" (or, with
# DEV_EMAIL_CONSOLE=true outside production, printed and recorded as
# "logged_dev"). It is never recorded as sent when it was not.
# Push needs a provider: see README, "Recurring transactions and bill reminders".
